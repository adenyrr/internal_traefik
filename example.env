# Docker rootless de deploy (UID 1001)
SOCKET=/run/user/1001/docker.sock
# Interface privée joignable depuis BunkerWeb ; 127.0.0.1 si WAF sur le même hôte.
BIND_IP=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Port HTTPS vu par les clients, derrière BunkerWeb.
PUBLIC_HTTPS_PORT=443
# IP/CIDR du proxy de confiance telle que vue par Traefik (attention au NAT rootless).
EXTERNAL_PROXY=192.0.2.1/32
ACME_EMAIL=mail@example.com
TRAEFIK_HOST=traefik.example.com
# Token Cloudflare : Zone:Read et DNS:Edit, limité aux zones concernées.
CF_DNS_API_TOKEN=
# Outpost Authentik existant (embarqué ou dédié), URL sans slash final.
AUTHENTIK_OUTPOST_URL=https://authentik.example.com
